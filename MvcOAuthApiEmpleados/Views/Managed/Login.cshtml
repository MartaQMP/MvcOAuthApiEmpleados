<h1>Login</h1>
<hr />
<form method="post">
    <label class="form-label">Introduce el usuario:</label>
    <input class="form-control" type="text" name="username" />
    <label class="form-label">Introduce la contraseña:</label>
    <input class="form-control" type="text" name="password" />
    <br />
    <button class="btn btn-outline-dark">Log In</button>
</form>
<hr />
<p>@ViewBag.Mensaje</p>